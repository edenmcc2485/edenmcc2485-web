        "fill-outline-color": "rgba(118, 156, 105, 1)"
      }
    },
    {
      "id": "monitering locations",
      "type": "circle",
      "source": "monitering locations discharge values",
      "layout": {"visibility": "visible"},
      "paint": {
        "circle-radius": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4,
          [
            "interpolate",
            ["linear"],
            ["sqrt", ["coalesce", ["get", "mean_cfs"], 0]],
            0,
            1.5,
            95,
            10
          ],
          9,
          [
            "interpolate",
            ["linear"],
            ["sqrt", ["coalesce", ["get", "mean_cfs"], 0]],
            0,
            3,
            95,
            28
          ]
        ],
        "circle-color": "rgba(39, 133, 228, 1)",
        "circle-opacity": 0.6,
        "circle-stroke-color": "rgba(255, 255, 255, 1)",
        "circle-stroke-opacity": 1,
        "circle-stroke-width": 1
      }
    },
    {
      "id": "Colorado River",
      "type": "line",
      "source": "rivers within watershed",
      "filter": ["any", ["==", "NAME", "Colorado River"]],
      "layout": {"visibility": "visible"},
      "paint": {"line-color": "rgba(39, 133, 228, 1)", "line-width": 2.5}
    },
    {
      "id": "Major Cities Using the Colorado",
      "type": "circle",
      "source": "Major Cities that use the Colorado River",
      "paint": {"circle-color": "rgba(240, 114, 26, 1)"}
    }
