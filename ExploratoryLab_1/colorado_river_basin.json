      },
      "paint": {
        "text-color": "#333",
        "text-halo-blur": 1,
        "text-halo-color": "#fff",
        "text-halo-width": 1
      }
    },
    {
      "id": "background",
      "type": "background",
      "filter": ["any"],
      "layout": {"visibility": "visible"},
      "paint": {"background-color": "rgb(242,243,240)", "background-opacity": 0}
    },
    {
      "id": "Alfalfa Counties",
      "type": "fill",
      "source": "Alfalfa Counties",
      "layout": {"visibility": "none"},
      "paint": {"fill-opacity": 0.3}
    },
    {
      "id": "lower basin alfalfa zones",
      "type": "fill",
      "source": "lower basin alfalfa zones",
      "paint": {"fill-color": "rgba(96, 3, 3, 1)", "fill-opacity": 0.25}
    },
    {
      "id": "upper basin alfalfa zones",
